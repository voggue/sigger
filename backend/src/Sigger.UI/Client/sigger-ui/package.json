{
  "name": "sigger-ui-client",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public --no-clear",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "copy:bundle": "copyfiles -f public/build/* ./../../Resources/build",
    "copy:public": "copyfiles -f  public/global.css ./../../Resources",
    "copy": "npm run copy:bundle & npm run copy:public",
    "deploy": "npm run build&npm run copy"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "picomatch": "^4.0.7",
    "rollup": "^2.80.0",
    "rollup-plugin-css-only": "^3.1.0",
    "rollup-plugin-livereload": "^2.0.0",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@microsoft/signalr": "^6.0.7",
    "copyfiles": "^2.4.1",
    "sirv-cli": "^2.0.0"
  }
}
